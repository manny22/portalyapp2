# Janora Web — variables de entorno
# Copiar este archivo a .env y ajustar los valores

# Modo de datos: "mock" usa datos dummy locales
VITE_DATA_MODE=mock

# Nombre de la app (usado en el título y branding)
VITE_APP_NAME=Janora

# URL pública del backend, embebida durante npm run build
VITE_API_BASE_URL=http://localhost:3000/api/v1
